{
  "name": "tall-grass-clicker",
  "version": "0.1.0",
  "private": true,
  "description": "An unofficial fan-made creature-catching clicker for the browser: click to battle, catch and evolve all 649 Gen 1-5 creatures, hunt shinies, retire and start again stronger.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "author": "Carlos Ducamp",
  "repository": { "type": "git", "url": "git+https://github.com/ducampcarlos/tall-grass-clicker.git" },
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "balance": "node --import tsx src/sim/balance.ts",
    "dex": "node scripts/gen-dex.mjs",
    "sprites": "bash scripts/fetch-sprites.sh"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
